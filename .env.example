POSTGRES_DB=workout_tracker
POSTGRES_USER=workout_user
POSTGRES_PASSWORD=workout_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/workout_tracker
SPRING_DATASOURCE_USERNAME=workout_user
SPRING_DATASOURCE_PASSWORD=workout_password

# Local password recovery through Mailpit (http://localhost:8025)
APP_MAIL_ENABLED=true
APP_FRONTEND_BASE_URL=http://localhost:5173
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# Neon example (keep real credentials in an untracked .env or terminal environment)
# SPRING_PROFILES_ACTIVE=neon
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-role>
# SPRING_DATASOURCE_PASSWORD=<neon-password>

# Production backend example (use deployment secrets, not this file)
# SPRING_PROFILES_ACTIVE=prod
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com
# APP_FRONTEND_BASE_URL=https://app.example.com
# APP_MAIL_FROM=no-reply@example.com
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=<smtp-username>
# SPRING_MAIL_PASSWORD=<smtp-password>
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_STARTTLS_ENABLE=true
